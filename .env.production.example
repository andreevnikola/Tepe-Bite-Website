# Production runtime environment for ТЕПЕ bite.
#
# This file documents every variable the systemd service reads from
# /etc/tepebite.env on the VPS. It contains NO real secrets — copy it to
# /etc/tepebite.env on the server and fill in real values there, chmod 640,
# owned by root:deploy. Never commit the filled-in file.
#
# NEXT_PUBLIC_* variables are NOT read from this file — they are baked into
# the client bundle at build time by GitHub Actions (see .github/workflows/
# deploy-production.yml) from repository Variables, not from this file.

# ─── Runtime (also set directly in infra/systemd/tepebite.service; harmless
#      to repeat here, systemd Environment= wins over EnvironmentFile) ────────
NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3000
NEXT_TELEMETRY_DISABLED=1

# ─── Database (Postgres — Neon, orders/inventory) ──────────────────────────────
POSTGRESQL_URL=postgresql://user:password@host:5432/tepebite
POSTGRES_SSL=true
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_SIZE=5

# ─── App ────────────────────────────────────────────────────────────────────────
# Must be https://tepebite.eu in production.
APP_BASE_URL=https://tepebite.eu

# ─── MongoDB (admin dashboard — initiatives & partners) ────────────────────────
# Runtime credential used by the deployed server process. Separate from the
# build-time MONGODB_BUILD_URI secret used only inside GitHub Actions to
# prerender the public pages — see docs/deployment.md.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/tepe_dashboard?appName=Primary
# Signing secret for admin session cookies. 32+ random chars.
SESSION_SECRET=

# ─── Email (Resend) ─────────────────────────────────────────────────────────────
# All outbound app email (order confirmations, chatbot escalations) sends via
# Resend. There is no SMTP transport in this app.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@tepebite.eu
EMAIL_FROM_NAME=ТЕПЕ bite
EMAIL_REPLY_TO=office@tepebite.eu

# ─── Reserved — provisioned for planned features, not yet wired into any code
#      path. Safe to leave empty; nothing reads them yet. ───────────────────────
OFFICE_INBOX_ADDRESS=office@tepebite.eu
IMPACT_INBOX_ADDRESS=impact@tepebite.eu
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_SEARCH_INSTANCE=
CLOUDFLARE_AI_SEARCH_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── UploadThing & translation ──────────────────────────────────────────────────
UPLOADTHING_TOKEN=
DEEPL_API_KEY=

# ─── Delivery pricing (EUR cents) — MUST match the NEXT_PUBLIC_ build-time
#      copies of these same four values (repository Variables), or checkout
#      creation will refuse to run. See src/lib/config/validators/checkout.config.ts ─
TEPE_DELIVERY_BASE_LOCKER_CENTS=230
TEPE_DELIVERY_OFFICE_SURCHARGE_CENTS=100
TEPE_DELIVERY_ADDRESS_SURCHARGE_CENTS=230
TEPE_FREE_DELIVERY_THRESHOLD_CENTS=3000

# ─── Courier ─────────────────────────────────────────────────────────────────────
# manual | speedy_api ("mock" is refused when NODE_ENV=production)
COURIER_LOCATION_PROVIDER=manual
SPEEDY_API_CLIENT_ID=
SPEEDY_API_SECRET=

# ─── Admin ───────────────────────────────────────────────────────────────────────
# One-time key used to bootstrap the first admin account. Rotate/blank after use.
ADMIN_BOOTSTRAP_KEY=

# --- Claudflare related information for the AI chatbot ---------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_SEARCH_API_TOKEN=
CLOUDFLARE_AI_SEARCH_INSTANCE=tepebite
